/target
/apps/target
/dist
/web/dist
.env
# The managed Keycloak's admin password, where earlier builds kept it. It now lives in
# ~/.local/share/ccosel/ and is moved there on the next start.
/data/keycloak-admin-password
# Per-machine Claude Code permissions; the shared settings.json is committed.
/.claude/settings.local.json
# Users' private folders are created by the server on first use; they are data, not source.
/data/shared/home/
# Temporary project uploads the server makes in the jail it serves; deleted on their own.
/data/shared/.scratch/
# Local git worktrees, one per branch being worked on or reviewed.
/.worktrees/
