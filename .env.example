# Where browsers reach this server, when it is behind an HTTPS tunnel or proxy.
# CCOSEL_PUBLIC_URL=https://ccosel.example.com

# Only for a Keycloak of your own. Leave these unset and the server starts one itself (Docker).
# CCOSEL_KEYCLOAK_URL=https://sso.example.com/realms/ccosel
# CCOSEL_KEYCLOAK_CLIENT_ID=ccosel
# CCOSEL_KEYCLOAK_CLIENT_SECRET=  # only needed for confidential clients
